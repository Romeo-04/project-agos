# Stray screenshots at repo root (Playwright writes here when the filename
# has no path prefix). Always pass .playwright-mcp/<name>.png instead.
/*.png
/*.jpeg
/*.webp

# Playwright MCP session artifacts (snapshots, traces, page dumps)
.playwright-mcp/

# Playwright / browser automation artifacts — never committed (per project policy)
screenshots/
.playwright/
playwright-report/
test-results/
*.webm
trace.zip
build/screens/
**/playwright/**/*.png

# Exported chart images and the assembled PDF. These are screenshots of the
# SAC story, so the no-screenshots rule covers them. The README that explains
# how to regenerate them IS tracked.
deck/charts/
deck/photos/
deck/*.pdf

# Claude skills ARE tracked (explicit exception to the image rule)
!.claude/skills/**

# Local env / secrets
.env
.env.*
credentials.json
*.pem

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
